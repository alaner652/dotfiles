{
  "layer": "top",
  "position": "top",
  "height": 50,

  "margin-top": 8,
  "margin-bottom": 0,
  "margin-left": 20,
  "margin-right": 20,

  "spacing": 5,
  "fixed-center": true,

  "modules-left": ["custom/power", "clock", "hyprland/window"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "custom/battery",
    "custom/notifications"
  ],

  "clock": {
    "format": "󰥔 {:%I:%M %p}",
    "tooltip-format": "{:%Y-%m-%d (%a) %I:%M %p}"
  },

  "hyprland/window": {
    "format": "{class}",
    "max-length": 40,
    "rewrite": {
      "^Code$": " Visual Studio Code",
      "^vesktop$": "󰙯 Discord",
      "^brave$|^brave-browser$": " Brave",
      "^org.pulseaudio.pavucontrol$": "󰕾 Pavucontrol",
      "^com\\.github\\.th_ch\\.youtube_music$": "󰎈 YouTube Music",
      "^com\\.obsproject\\.Studio$": "OBS Studio",
      "^.* - Neovim( .*|$)": " Neovim",
      "^kitty$": "󰄛 Kitty",
      "\\.pdf$": " PDF",
      "^$": " Empty"
    }
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by-number": true
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "default": ["", ""]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "tooltip-format": "{desc}\n{volume}%"
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "  {essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "󰈀 Wired",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 20
  },

  "cpu": {
    "format": " {usage}%",
    "tooltip-format": "CPU 使用率 {usage}%"
  },

  "memory": {
    "format": "󰍛 {used}/{total}",
    "tooltip-format": "已用 {used} / 總共 {total}"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 15
  },

  "custom/battery": {
    "exec": "~/.config/waybar/scripts/battery.sh",
    "interval": 5,
    "return-type": "json"
  },

  "custom/power": {
    "format": "",
    "tooltip-format": "電源選單",
    "on-click": "wlogout"
  },

  "custom/notifications": {
    "format": "󰅸",
    "tooltip-format": "通知中心",
    "on-click": "swaync-client -t"
  }
}
