{
  "layer": "top",
  "position": "top",
  "height": 80,

  "margin-top": 8,
  "margin-bottom": 0,
  "margin-left": 20,
  "margin-right": 20,

  "spacing": 5,
  "fixed-center": true,

  "modules-left": ["custom/power", "clock", "hyprland/window"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "battery",
    "custom/notifications",
  ],

  "clock": {
    "format": "󰥔 {:%I:%M %p}",
    "tooltip-format": "{:%Y-%m-%d (%a) %I:%M %p}",
  },

  "hyprland/window": {
    "format": "{class}",
    "max-length": 40,
    "rewrite": {
      "^Code$": " Visual Studio Code",
      "^vesktop$": "󰙯 Discord",
      "^brave$|^brave-browser$": " Brave",
      "^org.pulseaudio.pavucontrol$": "󰕾 Pavucontrol",
      "^com\\.github\\.th_ch\\.youtube_music$": "󰎈 YouTube Music",
      "^com\\.obsproject\\.Studio$": "OBS Studio",
      "^.* - Neovim( .*|$)": " Neovim",
      "^kitty$": "󰄛 Kitty",
      "\\.pdf$": " PDF",
      "^$": " Empty",
    },
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by-number": true,
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["", ""],
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"],
    "tooltip-format": "{desc}\n{volume}%",
  },

  "network": {
    "interface": "", // enp42s0
    "format": "{ifname}",
    "format-wifi": "  {essid}",
    "format-ethernet": "󰊗 {ifname}",
    "format-disconnected": "󰖪",
    "tooltip-format": "󰊗  {ifname} via {gwaddr} ",
    "tooltip-format-wifi": "  {essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "  {ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
  },

  "cpu": {
    "format": " {usage}%",
    "tooltip-format": "CPU 使用率 {usage}%",
  },

  "memory": {
    "format": "󰍛 {used}/{total}",
    "tooltip-format": "已用 {used} / 總共 {total}",
  },

  "tray": {
    "icon-size": 16,
    "spacing": 15,
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": " {capacity}% {icon}",
    "format-plugged": " {capacity}% {icon}",
    "format-alt": "{timeTo} {status}",
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15,
    },
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{capacity}%\n{timeTo} {status}",
  },

  "custom/power": {
    "format": "",
    "tooltip-format": "電源選單",
    "on-click": "wlogout",
    "signal": 0,
  },

  "custom/notifications": {
    "format": "󰅸",
    "tooltip-format": "通知中心",
    "on-click": "swaync-client -t",
  },
}
