{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "$(~/.config/fastfetch/random_logo.sh)",
    "type": "kitty",
    "height": 10,
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom"
    },
    {
      "key": "│ {#31} User    {#keys}│",
      "type": "title",
      "format": "{user-name}"
    },
    {
      "key": "│ {#32}󰇅 Host    {#keys}│",
      "type": "title",
      "format": "{host-name}"
    },
    {
      "key": "│ {#33}󰅐 Uptime  {#keys}│",
      "type": "uptime"
    },

    {
      "key": "│ {#35} Kernel  {#keys}│",
      "type": "kernel"
    },
    {
      "key": "│ {#36}󰇄 Desltop {#keys}│",
      "type": "de"
    },
    {
      "key": "│ {#31} Termial {#keys}│",
      "type": "terminal"
    },
    {
      "key": "│ {#32} Shell   {#keys}│",
      "type": "shell"
    },
    {
      "key": "│ {#33}󰍛 CPU     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true
    },
    {
      "key": "│ {#34}󰉉 Disk    {#keys}│",
      "type": "disk",
      "folders": "/"
    },
    {
      "key": "│ {#35} Memory  {#keys}│",
      "type": "memory"
    },
    {
      "key": "│ {#36}󰩟 Network {#keys}│",
      "type": "localip",
      "format": "{ipv4} ({ifname})"
    },
    {
      "key": "├───────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#39} Colors  {#keys}│",
      "type": "colors",
      "symbol": "circle"
    },
    {
      "key": "╰───────────╯",
      "type": "custom"
    }
  ]
}
